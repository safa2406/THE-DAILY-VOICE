# ==============================================================================
# The Daily Voice - Backend Environment Variables
# ==============================================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production
PORT=5000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (Supabase PostgreSQL)
# Direct connection: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Pooler connection (Session/Transaction): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Anon Key (Public)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase Service Role Key (Backend ONLY - DO NOT EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Supabase JWT Secret (Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Storage Buckets (Supabase Storage)
SUPABASE_STORAGE_BUCKET_AUDIO=audiobooks
SUPABASE_STORAGE_BUCKET_NEWSPAPERS=newspapers

# Groq AI Configuration (Summarization & Translation)
# Supported free-tier model: openai/gpt-oss-120b (default) or openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

