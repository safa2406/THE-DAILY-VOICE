# ==============================================================================
# The Daily Voice - Frontend Environment Variables
# ==============================================================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000

# Supabase Public Configuration (Safe for client-side usage)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: NEVER expose SUPABASE_SERVICE_ROLE_KEY or SUPABASE_JWT_SECRET in frontend!
